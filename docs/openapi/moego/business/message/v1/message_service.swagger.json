  "paths": {
    "/v1/messages:sendToCustomer": {
      "post": {
        "summary": "Sends a message to a customer.",
        "description": "Creates or reuses a conversation thread for the customer, then sends the message\nusing the given delivery method (msg / email / call / app). The message body and\ntype (text or pic) are supplied by the caller; thread creation is handled internally.",
        "operationId": "MessageService_SendMessageToCustomer",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SendMessageToCustomerResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "Request for SendMessageToCustomer.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SendMessageToCustomerRequest"
            }
          }
        ],
        "tags": [
          "moego.business.message.v1.MessageService"
        ]
      }
    }
  },
