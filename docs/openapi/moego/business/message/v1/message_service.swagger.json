    "v1MessageDeliveryMethod": {
      "type": "string",
      "enum": [
        "MESSAGE_DELIVERY_METHOD_UNSPECIFIED",
        "MSG",
        "EMAIL",
        "CALL",
        "APP"
      ],
      "default": "MESSAGE_DELIVERY_METHOD_UNSPECIFIED",
      "description": "Delivery method (channel) for sending the message to the customer.\nNumeric values align with product: 1-msg, 2-email, 4-call, 5-app (3 reserved).\n\n - MESSAGE_DELIVERY_METHOD_UNSPECIFIED: Unknown or unspecified delivery method.\n - MSG: In-app / internal message (msg).\n - EMAIL: Email.\n - CALL: Phone call (call).\n - APP: App push or in-app (app)."
    },
    "v1MessageType": {
      "type": "string",
      "enum": [
        "MESSAGE_TYPE_UNSPECIFIED",
        "TEXT",
        "PIC"
      ],
      "default": "MESSAGE_TYPE_UNSPECIFIED",
      "description": "Content type of the message body.\n\n - MESSAGE_TYPE_UNSPECIFIED: Unknown or unspecified message type.\n - TEXT: Plain text message.\n - PIC: Picture / image message."
    },
    "v1SendMessageToCustomerRequest": {
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string",
          "description": "Customer id to send the message to (obfuscated id)."
        },
        "phoneNumber": {
          "type": "string",
          "x-nullable": true,
          "description": "Phone number to use when the customer has multiple phones (e.g. E.164 format).\nRequired when delivery method is CALL or when sending to a specific phone; otherwise optional."
        },
        "messageBody": {
          "type": "string",
          "description": "Message body content (e.g. plain text \"hello\", or reference for PIC type)."
        },
        "messageType": {
          "$ref": "#/definitions/v1MessageType",
          "description": "Message content type: TEXT or PIC. Defaults to TEXT if not set."
        },
        "method": {
