  "paths": {
    "/v1/aggregation/clients:lookupClientPetProfile": {
      "post": {
        "summary": "Looks up client and pet profile by phone number for the given business.",
        "description": "Resolves customer by phone, returns minimal customer profile, all pets\nwith feeding/medication/vaccine details, and last/next appointment summaries.",
        "operationId": "AggregationService_LookupClientPetProfile",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1LookupClientPetProfileResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "Request to lookup client and pet profile by phone (e.g. receptionist or integration scenarios).",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1LookupClientPetProfileRequest"
            }
          }
        ],
        "tags": [
          "moego.business.aggregation.v1.AggregationService"
        ]
      }
    }
  },
